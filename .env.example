# Copy this to `.env` on the VPS (it's gitignored).
# docker-compose reads this file automatically when you run `docker compose up`.

# Prisma SQLite file inside the persistent named volume.
DATABASE_URL="file:/app/data/prod.db"

# Set to 1 ONLY on the very first boot to seed the demo content + admin user.
# After the initial seed, comment this out or set back to 0 so restarts don't
# wipe & re-seed the database.
SEED_DB=0

# Admin login. Required: without all three, nobody can log in.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-long-random-password"
# 32+ random characters; signs the login cookie. e.g. openssl rand -hex 32
SESSION_SECRET=""
